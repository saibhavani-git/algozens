<div class="p-4" style="background-color: #0f0f0f; color: #f1f1f1; min-height: 100vh;">
  <!-- Question Card -->
    <!-- <a href="/dsa/<%= question.category%>">back</a> -->
    <button onclick="window.location.href='/dsa/<%= question.category %>'" class="btn btn-outline-light mb-3">
      ← Back
    </button>
    

  <div class="mb-4" style="background-color: #1a1a1a; border: 1px solid #333; padding: 2rem; border-radius: 10px;">
    <h2 class="mb-3" style="color: #ffffff;"><%= question.title %></h2>
    <p class="text-muted mb-3"><%= question.description %></p>

    <h5 style="color: #ccc;">Input Format:</h5>
    <pre style="background-color: #2a2a2a; padding: 1rem; border-radius: 5px;"><%= question.inputFormat %></pre>

    <h5 class="mt-4" style="color: #ccc;">Output Format:</h5>
    <pre style="background-color: #2a2a2a; padding: 1rem; border-radius: 5px;"><%= question.outputFormat %></pre>

    <h5 class="mt-4" style="color: #ccc;">Test Cases:</h5>
    <% if (question.testCases && Array.isArray(question.testCases)) { %>
      <% question.testCases.forEach(testCase => { %>
        <div style="background-color: #2a2a2a; padding: 1rem; border-radius: 5px; margin-bottom: 10px;">
          <p><strong style="color: #88c0d0;">Input:</strong> <%= testCase.input %></p>
          <p><strong style="color: #a3be8c;">Expected Output:</strong> <%= testCase.expectedOutput %></p>
        </div>
      <% }) %>
    <% } else { %>
      <p style="color: #f39c12;">No test cases available for this question.</p>
    <% } %>
  </div>

  <!-- AI Response -->
  <div class="mb-4 w-100" style="background-color: #1a1a1a; border: 1px solid #333; padding: 2rem; border-radius: 10px;">
    <h4 style="color: #ffffff;">AI Response</h4>
    <textarea 
      id="aiResponse"
      class="form-control w-100"
      rows="8"
      style="background-color: #2d2d2d; color: #e0e0e0; border: none; margin-top: 1rem; resize: vertical; min-height: 150px; width: 100%;"
      readonly
    ><%= result && result.response ? result.response.text() : "AI response will appear here..." %></textarea>
  </div>

  <!-- Code Editor -->
  <div class="mb-4" style="background-color: #1a1a1a; border: 1px solid #333; padding: 2rem; border-radius: 10px;">
    <h4 style="color: #ffffff;">Your Solution</h4>
    <div id="editor" style="height: 300px; border: 1px solid #444; background-color: #222; border-radius: 5px; margin-top: 1rem;"></div>
  </div>

  <!-- Submit & Run Buttons -->
  <!-- <div class="text-center d-flex justify-content-center gap-3 mt-3 flex-wrap">
    <form action="/dsa/<%= question.category %>/<%= question._id %>" method="POST" id="codeForm" class="d-inline">
      <input type="hidden" name="code" id="code">
      <button type="submit" class="btn btn-primary px-4 py-2" style="font-size: 1.1rem;">Hint</button>
    </form>

    <button type="button" class="btn btn-success px-4 py-2" onclick="runCode()" style="font-size: 1.1rem;">Run Code</button>
  </div>
</div> -->
<div class="d-flex justify-content-start gap-3 mt-3">
  <!-- Form for Hint button -->
  <form action="/dsa/<%= question.category %>/<%= question._id %>" method="POST" id="codeForm" class="d-inline-block">
    <input type="hidden" name="code" id="code">
    <button type="submit" class="btn btn-dark text-white px-4 py-2" style="font-size: 1.1rem;">Hint</button>
  </form>

  <!-- Run Code button -->
  <button type="button" class="btn btn-dark text-white px-4 py-2" onclick="runCode()" style="font-size: 1.1rem;">Run Code</button>
</div>
<div>
  <!-- Output -->
  <pre id="outputArea" style="margin-top: 1rem; background-color: #111; color: #0f0; padding: 1rem; border-radius: 8px;"></pre>
</div>

<!-- Monaco Editor -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.38.0/min/vs/loader.min.js"></script>
<script>
  var editorInstance;
  const questionId = "<%= question._id %>";
  const storageKey = `code-${questionId}`;

  require.config({ paths: { 'vs': 'https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.38.0/min/vs' } });
  require(["vs/editor/editor.main"], function () {
    const savedCode = localStorage.getItem(storageKey) || <%- JSON.stringify(storedCode || "// Write your solution here...") %>;
    console.log(storageKey,savedCode);
    editorInstance = monaco.editor.create(document.getElementById("editor"), {
      value: savedCode,
      language: "javascript",
      theme: "vs-dark",
      automaticLayout: true
    });
  });

  document.getElementById("codeForm").addEventListener("submit", function (event) {
    event.preventDefault();
    const code = editorInstance.getValue();
    document.getElementById("code").value = code;
    localStorage.setItem(storageKey, code);
    this.submit();
  });
</script>

<!-- Run Code using Judge0 -->
<script>
  async function runCode() {
    const sourceCode = btoa(editorInstance.getValue());
    const input = btoa(`<%= question.testCases && question.testCases[0]?.input || "" %>`);
    const outputArea = document.getElementById("outputArea");
    //console.log(sourceCode)
    outputArea.textContent = "Running...";

    try {
      const response = await fetch("https://judge0-ce.p.rapidapi.com/submissions?base64_encoded=true&wait=true&fields=*", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "x-rapidapi-key": "260d3697c1msh6a7e5cff2752532p175c7cjsn4bb140c247e6",
          "x-rapidapi-host": "judge0-ce.p.rapidapi.com"
        },
        body: JSON.stringify({
          language_id: 52,
          source_code: sourceCode,
          stdin: input
        })
      });

      const result = await response.json();

      const stdout = result.stdout ? atob(result.stdout) : "";
      const stderr = result.stderr ? atob(result.stderr) : "";
      const compile_output = result.compile_output ? atob(result.compile_output) : "";
      const status = result.status?.description || "Unknown";

      outputArea.textContent = `
Status: ${status}

Output:
${stdout}

Error:
${stderr}

Compiler Output:
${compile_output}
      `;
    } catch (error) {
      outputArea.textContent = "An error occurred while running your code.";
      console.error(error);
    }
  }
</script>
