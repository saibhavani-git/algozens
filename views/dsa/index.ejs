<% layout('layouts/boilerplate') %>

<div class="page-head">
    <div>
        <p class="page-kicker">Practice</p>
        <h1 class="page-title">Choose a topic</h1>
        <p class="page-subtitle">Finish brute force, better, then optimized. A question counts as solved only after all three are confirmed.</p>
    </div>
</div>

<div class="stat-row mb-4">
    <div class="stat-card stat-solved">
        <span class="stat-label">Questions solved</span>
        <strong><%= solvedCount %><span class="stat-over"> / <%= totalQuestions %></span></strong>
        <span class="stat-hint">All 3 approaches complete</span>
    </div>
    <div class="stat-card stat-progress">
        <span class="stat-label">In progress</span>
        <strong><%= inProgress %></strong>
        <span class="stat-hint">Started, not fully solved</span>
    </div>
    <div class="stat-card stat-left">
        <span class="stat-label">Remaining</span>
        <strong><%= Math.max(totalQuestions - solvedCount, 0) %></strong>
        <span class="stat-hint">Still to complete</span>
    </div>
</div>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    <% categories.forEach((cat, i) => { %>
        <div class="col">
            <a href="/dsa/<%= cat.slug %>" class="az-card-link">
                <div class="az-card topic-card tone-<%= i % 7 %>">
                    <div class="card-body">
                        <div class="az-icon"><i class="<%= cat.icon %>"></i></div>
                        <h5 class="card-title"><%= cat.name %></h5>
                        <p class="card-text"><%= cat.blurb %></p>
                        <div class="topic-progress">
                            <div class="topic-progress-top">
                                <span><%= cat.solved %> / <%= cat.count %> solved</span>
                                <span><%= cat.count ? Math.round((cat.solved / cat.count) * 100) : 0 %>%</span>
                            </div>
                            <div class="topic-bar">
                                <span style="width: <%= cat.count ? Math.round((cat.solved / cat.count) * 100) : 0 %>%"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    <% }) %>
</div>
