<% layout('layouts/boilerplate')%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DSA Categories</title>
    <!-- <link rel="stylesheet" href="/public/styles.css"> -->
</head>
<body>
    <div class="container">
        <!-- <h1 class="text-center mt-5">DSA Categories</h1>
     -->
        <div class="row row-cols-1 row-cols-md-3 g-4 mt-4">
            <!-- Arrays -->
            <div class="col" >
                <div class="card">
                    <a href="/dsa/arrays" class="text-decoration-none">
                        <div class="card-body text-center">
                            <h5 class="card-title">Arrays</h5>
                            <p class="card-text">Data structure for storing elements in a contiguous memory block.</p>
                        </div>
                    </a>
                </div>
            </div>
    
            <!-- Linked List -->
            <div class="col">
                <div class="card">
                    <a href="/dsa/linked-list" class="text-decoration-none">
                        <div class="card-body text-center">
                            <h5 class="card-title">Linked List</h5>
                            <p class="card-text">Linear data structure where elements are connected using pointers.</p>
                        </div>
                    </a>
                </div>
            </div>
    
            <!-- Searching -->
            <div class="col">
                <div class="card">
                    <a href="/dsa/searching" class="text-decoration-none">
                        <div class="card-body text-center">
                            <h5 class="card-title">Searching</h5>
                            <p class="card-text">Algorithms to find an element within a data structure.</p>
                        </div>
                    </a>
                </div>
            </div>
    
            <!-- Sorting -->
            <div class="col">
                <div class="card">
                    <a href="/dsa/sorting" class="text-decoration-none">
                        <div class="card-body text-center">
                            <h5 class="card-title">Sorting</h5>
                            <p class="card-text">Algorithms to arrange elements in a specific order.</p>
                        </div>
                    </a>
                </div>
            </div>
    
            <!-- Dynamic Programming -->
            <div class="col">
                <div class="card">
                    <a href="/dsa/dynamic-programming" class="text-decoration-none">
                        <div class="card-body text-center">
                            <h5 class="card-title">Dynamic Programming</h5>
                            <p class="card-text">Optimization technique to solve problems by breaking them into subproblems.</p>
                        </div>
                    </a>
                </div>
            </div>
    
            <!-- Graphs -->
            <div class="col">
                <div class="card">
                    <a href="/dsa/graphs" class="text-decoration-none">
                        <div class="card-body text-center">
                            <h5 class="card-title">Graphs</h5>
                            <p class="card-text">Non-linear data structure used to represent connections.</p>
                        </div>
                    </a>
                </div>
            </div>
    
            <!-- Other -->
            <div class="col">
                <div class="card">
                    <a href="/dsa/other" class="text-decoration-none">
                        <div class="card-body text-center">
                            <h5 class="card-title">Other</h5>
                            <p class="card-text">Miscellaneous DSA topics that don’t fit into specific categories.</p>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>
    
   