<% layout('layouts/boilerplate') %>

<div class="d-flex align-items-start justify-content-between flex-wrap gap-3 mb-4">
    <div>
        <p class="page-kicker"><a href="/dsa" class="text-decoration-none" style="color: inherit;">Topics</a> / <%= categoryLabel %></p>
        <h1 class="page-title"><%= categoryLabel %></h1>
        <p class="page-subtitle">Each question has brute force, better, and optimized. It is marked solved only after all three are confirmed.</p>
    </div>
</div>

<div class="progress-wrap mb-4">
        <h5 id="progressText">Questions solved: 0 / 0 (0%)</h5>
    <div class="progress app-progress">
        <div
            class="progress-bar"
            id="progressBar"
            role="progressbar"
            style="width: 0%;"
            aria-valuenow="0"
            aria-valuemin="0"
            aria-valuemax="100"
        ></div>
    </div>
</div>

<% if (!question.length) { %>
    <div class="az-card category-empty">No questions in this category yet.</div>
<% } else { %>
    <div class="problem-list">
        <% question.forEach(q => { %>
            <div class="az-card problem-row">
                <input
                    class="form-check-input track-checkbox"
                    type="checkbox"
                    id="<%= q._id %>"
                    data-id="<%= q._id %>"
                    <%= set.includes(q._id.toString()) ? 'checked' : '' %>
                    disabled
                    title="Marked solved when all 3 approaches are done"
                    aria-label="<%= q.title %> solved status"
                >
                <div>
                    <h5 class="card-title"><%= q.title %></h5>
                    <p class="card-text"><%= q.description %></p>
                    <% const qp = progressByQuestion[q._id.toString()] || { brute: false, better: false, optimized: false, doneCount: 0, complete: false }; %>
                    <div class="approach-mini mt-2">
                        <% if (qp.brute) { %>
                            <a class="approach-pill pill-brute on" href="/dsa/<%= q.category %>/<%= q._id %>?approach=brute">Brute</a>
                        <% } else { %>
                            <span class="approach-pill pill-brute">Brute</span>
                        <% } %>
                        <% if (qp.better) { %>
                            <a class="approach-pill pill-better on" href="/dsa/<%= q.category %>/<%= q._id %>?approach=better">Better</a>
                        <% } else { %>
                            <span class="approach-pill pill-better">Better</span>
                        <% } %>
                        <% if (qp.optimized) { %>
                            <a class="approach-pill pill-opt on" href="/dsa/<%= q.category %>/<%= q._id %>?approach=optimized">Optimized</a>
                        <% } else { %>
                            <span class="approach-pill pill-opt">Optimized</span>
                        <% } %>
                        <span class="approach-count"><%= qp.doneCount %>/3</span>
                    </div>
                </div>
                <div class="problem-row-meta">
                    <span class="az-chip"><%= q.testCases.length %> test<%= q.testCases.length === 1 ? '' : 's' %></span>
                    <a href="/dsa/<%= q.category %>/<%= q._id %>" class="btn btn-accent btn-sm">Solve</a>
                </div>
            </div>
        <% }) %>
    </div>
<% } %>

<script>
    const total = <%= totalq %>;
    let solved = <%= solvedq %>;

    function updateProgress() {
        const percent = total > 0 ? ((solved / total) * 100).toFixed(0) : 0;
        document.getElementById('progressText').textContent = `Questions solved: ${solved} / ${total} (${percent}%)`;
        const bar = document.getElementById('progressBar');
        bar.style.width = `${percent}%`;
        bar.setAttribute('aria-valuenow', percent);
    }

    updateProgress();
</script>
