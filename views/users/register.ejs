<% layout('layouts/boilerplate') %>

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-4">
        <div class="auth-card">
            <div class="card-body">
                <p class="page-kicker">Get started</p>
                <h2 class="page-title">Create an account</h2>
                <p class="page-subtitle mb-4">Track solved problems and save your code.</p>
                <form action="/register" method="POST" class="validated-form" novalidate>
                    <div class="mb-3">
                        <label class="form-label" for="username">Username</label>
                        <input class="form-control" type="text" id="username" name="username" required autofocus>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="email">Email</label>
                        <input class="form-control" type="email" id="email" name="email" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="password">Password</label>
                        <input class="form-control" type="password" id="password" name="password" required>
                    </div>
                    <button class="btn btn-accent w-100 mt-2">Register</button>
                </form>
                <p class="auth-switch">Already have an account? <a href="/login">Log in</a></p>
            </div>
        </div>
    </div>
</div>
