<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Algozens</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/home.css">
</head>
<body class="d-flex text-center">
    <div class="company-wall" aria-hidden="true">
        <span>Google</span>
        <span>Amazon</span>
        <span>Microsoft</span>
        <span>Meta</span>
        <span>Apple</span>
        <span>Netflix</span>
        <span>Uber</span>
        <span>Airbnb</span>
        <span>Bloomberg</span>
        <span>Adobe</span>
        <span>NVIDIA</span>
        <span>Stripe</span>
        <span>Oracle</span>
        <span>Salesforce</span>
        <span>LinkedIn</span>
        <span>Spotify</span>
        <span>Palantir</span>
        <span>Atlassian</span>
        <span>Shopify</span>
        <span>PayPal</span>
        <span>Goldman Sachs</span>
        <span>Jane Street</span>
        <span>Flipkart</span>
        <span>PhonePe</span>
        <span>Razorpay</span>
        <span>Datadog</span>
        <span>Snowflake</span>
        <span>Intuit</span>
        <span>Tesla</span>
        <span>DoorDash</span>
        <span>Coinbase</span>
        <span>Twilio</span>
        <span>Dropbox</span>
        <span>Visa</span>
        <span>JPMorgan</span>
        <span>Infosys</span>
        <span>TCS</span>
    </div>
    <div class="cover-container d-flex w-100 h-100 p-3 mx-auto flex-column">
        <header class="mb-auto">
            <div>
                <h3 class="float-md-start mb-0 masthead-brand">
                    <span class="brand-mark">A</span>Algozens
                </h3>
                <nav class="nav nav-masthead justify-content-center float-md-end">
                    <a class="nav-link active" aria-current="page" href="/">Home</a>
                    <a class="nav-link" href="/dsa">Practice</a>
                    <% if (!currentUser) { %>
                        <a class="nav-link" href="/login">Login</a>
                        <a class="nav-link" href="/register">Register</a>
                    <% } else { %>
                        <a class="nav-link" href="/logout">Logout</a>
                    <% } %>
                </nav>
            </div>
        </header>
        <main class="px-3">
            <p class="hero-kicker">Data Structures & Algorithms</p>
            <h1 class="hero-title">Practice problems.<br>Get unstuck with hints.</h1>
            <p class="lead">
                Browse categorized DSA questions, mark what you have solved, and ask the AI for a nudge when you stall — not the full solution.
            </p>
            <a href="/dsa" class="btn btn-lg btn-solve mt-3">Start solving</a>
            <div class="home-stats">
                <div><strong><%= typeof topicCount !== 'undefined' ? topicCount : 7 %></strong>topics</div>
                <div><strong><%= typeof questionCount !== 'undefined' ? questionCount : 28 %></strong>problems</div>
                <div><strong>AI</strong>hints</div>
            </div>
        </main>
        <footer class="mt-auto text-white-50">
            <p>&copy; Algozens 2026</p>
        </footer>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
